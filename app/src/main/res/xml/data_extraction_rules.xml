<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup + device-to-device transfer (Android 12+).
  Keep secrets and local telephony-related data off backups/transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="database" path="odorik_database" />
        <exclude domain="database" path="odorik_database-shm" />
        <exclude domain="database" path="odorik_database-wal" />
        <exclude domain="sharedpref" path="sms_draft_prefs.xml" />
        <exclude domain="sharedpref" path="update_prefs.xml" />
        <exclude domain="file" path="datastore/app_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_prefs.xml" />
        <exclude domain="database" path="odorik_database" />
        <exclude domain="database" path="odorik_database-shm" />
        <exclude domain="database" path="odorik_database-wal" />
        <exclude domain="sharedpref" path="sms_draft_prefs.xml" />
        <exclude domain="sharedpref" path="update_prefs.xml" />
        <exclude domain="file" path="datastore/app_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
